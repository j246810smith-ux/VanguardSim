{
  "name": "vanguard-sim",
  "version": "0.18.0-alpha",
  "private": true,
  "description": "Unofficial offline Cardfight!! Vanguard simulator for the historical VG-BT01–BT17 card pool (fan project, not affiliated with Bushiroad)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "cards:import": "tsx scripts/cards/import.ts",
    "cards:validate": "tsx scripts/cards/validate.ts",
    "cards:report": "tsx scripts/cards/report.ts",
    "cards:reprints": "tsx scripts/cards/reprints.ts",
    "play": "tsx scripts/play.ts",
    "ai:bench": "tsx scripts/ai-bench.ts",
    "ai:compare": "tsx scripts/ai-compare.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "artwork:build": "tsx scripts/artwork-build.ts",
    "app": "npm run artwork:build && vite build && electron .",
    "ui:build:release": "vite build --mode release",
    "dist:win": "npm run artwork:build && vite build --mode release && electron-builder --win --x64 --publish never",
    "dist:smoke": "node scripts/release-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "main": "app/main/main.cjs",
  "license": "GPL-3.0-only",
  "author": "j246810smith-ux",
  "homepage": "https://github.com/j246810smith-ux/VanguardSim",
  "repository": {
    "type": "git",
    "url": "https://github.com/j246810smith-ux/VanguardSim.git"
  },
  "build": {
    "appId": "io.github.j246810smith-ux.vanguardsim",
    "productName": "Vanguard Sim",
    "artifactName": "VanguardSim-${version}-win-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!dist/renderer/cards/**"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "packaging/cards-README.txt",
        "to": "cards/README.txt"
      }
    ],
    "win": {
      "target": [
        "zip",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "VanguardSim-${version}-portable.exe"
    }
  }
}
