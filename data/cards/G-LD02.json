        "clan": "かげろう",
        "race": "フレイムドラゴン",
        "image": "/wordpress/wp-content/images/cardlist/G-LD02/gld02_001.png"
      },
      "en": {
        "number": "G-LD02/001EN",
        "name": "Transcendence Divine Dragon, Nouvelle Vague L'Express",
